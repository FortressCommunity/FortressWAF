        "x": 6,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(fortresswaf_requests_blocked[1m]) / clamp_min(rate(fortresswaf_requests_total[1m]), 1) * 100",
